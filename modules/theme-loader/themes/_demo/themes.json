      "id": "demo-mint-light",
      "name": { "en": "Demo · Mint (tokens only)", "de": "Demo · Minze (nur Tokens)" },
      "stage": "pure",
      "mode": "light",
      "base": "light",
      "seriousness": 8,
      "hype": 1,
      "description": "Pipeline proof: a light palette made only of Compound tokens, no CSS file.",
      "tokens": {
        "--cpd-color-theme-bg": "#f2fbf6",
        "--cpd-color-bg-canvas-default": "#f7fdf9",
        "--cpd-color-bg-subtle-secondary": "#dff3e8",
        "--cpd-color-bg-subtle-primary": "#c9ead8",
        "--cpd-color-text-primary": "#12352a",
        "--cpd-color-text-secondary": "#3f6b5c",
        "--cpd-color-text-action-accent": "#0b7a55",
        "--cpd-color-bg-accent-rest": "#0b7a55",
        "--cpd-color-bg-action-primary-rest": "#0b7a55",
        "--cpd-color-icon-accent-primary": "#0b7a55",
        "--cpd-color-border-interactive-secondary": "#9ccdb5"
      }
    },
    {
      "id": "demo-night-owl",
      "name": { "en": "Demo · Night owl (font, enhancer, daylight)", "de": "Demo · Nachteule (Font, Enhancer, Tageslicht)" },
      "stage": "exciting",
      "mode": "daylight",
      "base": "dark",
      "seriousness": 5,
      "hype": 6,
      "description": "Pipeline proof: dark at night, light by day, self-hosted Fira Code, CSS with an asset URL, an enhancer badge that follows the phase.",
