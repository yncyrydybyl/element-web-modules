      "tokens": {
        "--cpd-font-family-sans": "\"TL Demo Fira Code\", monospace",
        "--cpd-color-bg-canvas-default": "#1b1530",
        "--cpd-color-bg-subtle-secondary": "#251d41",
        "--cpd-color-bg-subtle-primary": "#2f2552",
        "--cpd-color-text-primary": "#efe9ff",
        "--cpd-color-text-secondary": "#b6a9dc",
        "--cpd-color-text-action-accent": "#ffb454",
        "--cpd-color-bg-accent-rest": "#ff9d1f",
        "--cpd-color-bg-action-primary-rest": "#ff9d1f",
        "--cpd-color-icon-accent-primary": "#ffb454"
      },
      "enhance": true,
      "schedule": [
        { "from": "06:00", "phase": "dawn", "base": "dark" },
        { "from": "09:00", "phase": "day", "base": "light" },
        { "from": "18:00", "phase": "dusk", "base": "dark" },
        { "from": "21:00", "phase": "night", "base": "dark" }
