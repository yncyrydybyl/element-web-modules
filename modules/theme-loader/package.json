{
    "name": "@datanauten/element-web-theme-loader",
    "version": "0.1.0",
    "description": "Element Web module: loads the element-web-themes families (tokens, CSS, fonts, enhancers, daylight schedules) with a Themes settings tab and a quick switcher",
    "private": true,
    "type": "module",
    "license": "AGPL-3.0-only",
    "packageManager": "pnpm@10.29.3",
    "scripts": {
        "build": "node build/build.mjs",
        "build:demo": "node build/build.mjs --show-demo",
        "check": "node build/check.mjs",
        "lint:types": "tsc --noEmit",
        "dev": "bash dev/start.sh",
        "dev:fg": "node dev/server.mjs",
        "dev:stop": "bash dev/stop.sh",
        "dev:status": "bash dev/status.sh",
        "test:e2e": "node test/e2e.cjs"
    },
    "devDependencies": {
        "@element-hq/element-web-module-api": "2.3.0",
        "@types/node": "^24.19.2",
        "@types/react": "^19.3.0",
        "esbuild": "^0.25.0",
        "postcss": "^8.5.0",
        "postcss-selector-parser": "^7.1.0",
        "typescript": "^5.9.3"
    }
}
