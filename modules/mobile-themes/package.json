        "test:smoke": "node test/smoke.mjs",
        "audit": "node test/audit.mjs",
        "test:shell": "node test/shell.mjs",
        "test:desktop": "node test/desktop.mjs"
    },
    "devDependencies": {
        "@element-hq/element-web-module-api": "2.3.0",
        "@types/node": "^24.19.2",
        "@types/react": "^19.3.0",
        "esbuild": "^0.25.0",
        "typescript": "^5.9.3"
    }
